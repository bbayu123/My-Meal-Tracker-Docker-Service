                <mxCell id="BLn4kZ0Jki_Ed7WSkoAJ-39" value="The only mandatory nutritional information are Energy, Protein, Total Fat, Saturated Fat, Carbohydrates, Sugars, and Sodium. All remaining values are optional and are filled in when provided." style="shape=note;size=11;whiteSpace=wrap;html=1;fontSize=8;" parent="1" vertex="1">
